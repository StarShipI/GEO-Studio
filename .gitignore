# === 敏感 / 运行时数据，绝不入库 ===
# 浏览器登录态（cookies/session），含各 AI 引擎登录凭证
data/browser_profile/
# 本地数据库（含真实采样与客户数据）
data/*.db*
data/wechat/
# 真实客户报告（含客户名/账号数据，不进公开仓库）
reports/
# 环境变量 / API keys
.env
.env.local
.env.*
!.env.example

# === 日志与临时产物 ===
*.log
*.err
left_tasks.json
**/__pycache__/
*.pyc
_shots/
*.txt
!requirements.txt

# === 编辑器 / 系统 ===
.vscode/
.idea/
Thumbs.db
.DS_Store

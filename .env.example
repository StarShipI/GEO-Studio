# 复制本文件为 .env 后按需修改（所有变量前缀为 GEO_）

# 数据库地址（SQLite 起步，数据文件落在 data/geo.db）
GEO_DATABASE_URL=sqlite:///./data/geo.db

# LLM 解析用（DeepSeek 兼容 OpenAI 接口，也可换其他 base_url）
GEO_LLM_API_BASE=https://api.deepseek.com/v1
GEO_LLM_API_KEY=sk-你的key
GEO_LLM_MODEL=deepseek-chat

# 飞书群机器人 webhook（留空则不推送告警）
GEO_FEISHU_WEBHOOK=

# 采集是否无头模式；首次登录 AI 引擎时请设为 false 手动完成一次登录
GEO_HEADLESS=true

# 调度器扫描间隔（分钟）与任务默认重采频率（小时）
GEO_SAMPLING_INTERVAL_MINUTES=60
GEO_DEFAULT_TASK_FREQUENCY_HOURS=24
